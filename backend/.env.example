# Database (AWS RDS PostgreSQL)
# Note: Remove the trailing port ":5432" from the terraform output if your service appends it separately, 
# or ensure DB_HOST points just to the hostname (e.g., fincommerce-ledger-db.c123456.us-east-1.rds.amazonaws.com)
DB_HOST=fincommerce-ledger-db.c0vwa6ec0rda.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=fincommercedb
DB_USER=finadmin
DB_PASSWORD=finadminpassword

# Caching (AWS ElastiCache Redis)
REDIS_HOST=fincommerce-idempotency-redis.qwuypm.0001.use1.cache.amazonaws.com
REDIS_PORT=6379

# Event-Driven Architecture (AWS EventBridge & SQS)
AWS_REGION=us-east-1
AWS_EVENT_BUS_NAME=fincommerce-production-bus
AWS_DLQ_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/fincommerce-fraud-dlq-production